{
  "expo": {
    "name": "ExcuseMe",
    "slug": "excuseme",
    "scheme": "excuseme",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
